[Unit]
Description=Wallet Watcher
After=network.target
Wants=network-online.target

[Service]
#WorkingDirectory=/path/to/your/venv
#ExecStartPre=/path/to/your/venv/bin/activate
ExecStart=/usr/local/bin/walletwatcher
Environment=PYTHONUNBUFFERED=1
LoadCredential=walletwatcher.conf:/etc/walletwatcher/walletwatcher.conf
LoadCredential=service-account-key.json:/etc/walletwatcher/service-account-key.json

# Process management
####################

Type=notify
NotifyAccess=all
PIDFile=/run/walletwatcher.pid

Restart=on-failure
TimeoutStartSec=infinity
TimeoutStopSec=600

# Hardening measures
####################

# Provide a private /tmp and /var/tmp.
PrivateTmp=true

# Mount /usr, /boot/ and /etc read-only for the process.
ProtectSystem=full

# Deny access to /home, /root and /run/user
ProtectHome=true

# Disallow the process and all of its children to gain
# new privileges through execve().
NoNewPrivileges=true

# Use a new /dev namespace only populated with API pseudo devices
# such as /dev/null, /dev/zero and /dev/random.
PrivateDevices=true

# Deny the creation of writable and executable memory mappings.
MemoryDenyWriteExecute=true

# Restrict ABIs to help ensure MemoryDenyWriteExecute is enforced
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
